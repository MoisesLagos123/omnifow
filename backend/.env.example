# Backend local config
DATABASE_URL=postgresql+psycopg://erp_app:cambiame@localhost:5432/mini_erp

# JWT
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=mini-erp
JWT_AUDIENCE=mini-erp-api
JWT_ACCESS_TTL_SECONDS=900       # 15 min
JWT_REFRESH_TTL_SECONDS=604800   # 7 days

# Auth policy
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Inventario — control de vencimiento por lotes (default global de alerta)
DIAS_ALERTA_VENCIMIENTO_DEFAULT=30

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173

# App
APP_ENV=dev

# Frontend (para construir links que viajan en emails — ej. reset password)
FRONTEND_BASE_URL=http://localhost:5173

# Reset password
RESET_PASSWORD_TTL_MINUTES=60

# Email
# - "logging" (dev/portfolio): escribe el link al log de uvicorn, NO envía emails reales.
# - "smtp" (producción): usa SMTP_HOST/PORT/USER/PASSWORD/EMAIL_FROM.
EMAIL_BACKEND=logging

# SMTP (solo aplica si EMAIL_BACKEND=smtp). Defaults para Resend.com (free 100/día).
# Para Resend: SMTP_USER=resend, SMTP_PASSWORD=tu API key (re_...).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_USER=
SMTP_PASSWORD=
# RFC 5322. Para Resend gratis: "OMNIFOW <onboarding@resend.dev>"
# Con dominio propio verificado: "OMNIFOW <noreply@tudominio.cl>"
EMAIL_FROM=OMNIFOW <onboarding@resend.dev>
